---
import type { SeasonData } from '../utils/loadData';
import TeamEvent from './TeamEvent.astro';
import IndividualEvent from './IndividualEvent.astro';

interface Props { season: SeasonData }
const { season } = Astro.props;

const teamEvents = season.events.filter(e => e.type === 'team' && e.level === 'regional');
const individualEvents = season.events.filter(e => e.type === 'individual' && e.level === 'regional');
const nationalEvents = season.events.filter(e => e.level === 'national');
---

<section class="season-section" id={season.season}>
  <h2 class="season-title">
    <a href={`#${season.season}`}>{season.season_label}</a>
  </h2>

  {season.note && <p class="season-note">{season.note}</p>}

  {teamEvents.length > 0 && (
    <div class="event-group">
      <h3>団体戦</h3>
      {teamEvents.map(e => <TeamEvent event={e} />)}
    </div>
  )}

  {individualEvents.length > 0 && (
    <div class="event-group">
      <h3>個人戦・その他</h3>
      {individualEvents.map(e => <IndividualEvent event={e} />)}
    </div>
  )}

  {nationalEvents.length > 0 && (
    <div class="event-group national-group">
      <h3>全国大会</h3>
      {nationalEvents.map(e =>
        e.type === 'team'
          ? <TeamEvent event={e} />
          : <IndividualEvent event={e} />
      )}
    </div>
  )}

  {teamEvents.length === 0 && individualEvents.length === 0 && nationalEvents.length === 0 && !season.note && (
    <p class="no-data">このシーズンのデータはまだ登録されていません。</p>
  )}
</section>

<style>
  /* season-note はこのコンポーネントが描画するため、スタイルもここに置く
     (result/index.astro 側に書くとスコープ属性が一致せず適用されない) */
  .season-note {
    background: #f5f1fa; border: 1px solid #e3d9f2; border-radius: 6px;
    padding: 0.5rem 0.8rem; margin-bottom: 1rem; font-size: 0.85rem; color: #5a4a70;
  }
</style>
