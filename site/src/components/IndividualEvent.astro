---
import type { Event } from '../utils/loadData';
import { isHighlight } from '../utils/loadData';

interface Props { event: Event }
const { event } = Astro.props;
const players = event.rikkyo_players ?? [];
const bbs = event.bbs_detail;
const highlight = isHighlight(event);
const sourceLabel = event.source_type.startsWith('kanto') ? '関東大学将棋連盟'
  : event.source_type === 'bbs' ? '掲示板'
  : event.source_type === 'manual' ? '部内記録'
  : event.source_type === 'club_html' ? '(旧)部サイト'
  : '全国連盟';
---

<div class:list={['event-card', 'event-individual', { highlight }]}>
  <div class="event-header">
    <span class="event-name">{event.name}</span>
    {event.level === 'national' && <span class="badge national">全国</span>}
    {bbs && !bbs.is_official && <span class="badge unofficial">非公式</span>}
  </div>

  {event.date && <div class="event-meta">📅 {event.date}{event.venue ? ` ／ ${event.venue}` : ''}</div>}

  {players.length > 0 && (
    <ul class="player-list">
      {players.map(p => (
        <li class:list={[{ highlight: ['優勝','準優勝','第三位'].includes(p.best_result ?? '') }]}>
          <span class="player-name">{p.name}</span>
          {p.grade != null && <span class="grade">{p.grade}年</span>}
          {p.best_result && <span class="best-result">{p.best_result}</span>}
          {p.rank != null && !p.best_result && <span class="rank">{p.rank}位</span>}
        </li>
      ))}
    </ul>
  )}

  {bbs && bbs.players.length > 0 && players.length === 0 && (
    <ul class="player-list">
      {bbs.players.map(p => (
        <li>
          <span class="player-name">{p.name}</span>
          {p.result && <span class="best-result">{p.result}</span>}
        </li>
      ))}
    </ul>
  )}

  {/* manual はリンク先となる公開URLが無いため、出典ラベルのみ表示する(requirements §5) */}
  <div class="source-link">
    {event.source_type === 'manual'
      ? <span class="source-plain">[出典: {sourceLabel}]</span>
      : <a href={event.source_url} target="_blank" rel="noopener">[{sourceLabel} 出典]</a>}
  </div>
</div>

<style>
  .source-link { margin-top: 0.4rem; font-size: 0.75rem; }
  .source-link a { color: #888; }
  .source-link a:hover { color: #541a86; }
  .source-plain { color: #999; }
</style>
