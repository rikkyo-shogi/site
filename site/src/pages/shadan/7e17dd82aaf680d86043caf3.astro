---
// 社団戦 個人レーティング推移(検証用)。
// 既存ページ(shadan/index.astro・ナビ)からはリンクしない独立ページ。
// 検証段階のため noindex にして検索エンジンにも出さない。
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShadanPlayerRating from '../../components/ShadanPlayerRating.astro';
import { loadShadanPlayers } from '../../utils/loadData';

const players = await loadShadanPlayers();  // 公開同意者のみ
---

<BaseLayout
  title="個人レーティング推移(検証用) — 立教大学将棋部"
  description="社団戦(東京アマチュア将棋連盟)における個人レーティング推移の表示検証ページ。"
  noindex
>
  <main>
    <h2 class="page-title">個人レーティング推移（検証用ページ）</h2>
    <p class="lead">
      社団戦結果ページとは独立した検証用ページです。本人の同意を得た部員のみ掲載しています。
    </p>

    <ShadanPlayerRating players={players} />
  </main>
</BaseLayout>

<style>
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem; }
  .page-title { font-size: 1.3rem; color: #541a86; margin: 0 0 0.5rem; }
  .lead { font-size: 0.85rem; color: #777; margin: 0 0 1.5rem; }
</style>
