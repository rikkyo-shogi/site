---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadShadanSeasons, type ShadanTeam } from '../../utils/loadData';

const seasons = await loadShadanSeasons();  // 新しい回順
const latest = seasons[0] ?? null;

// 歴代成績: 回ごとに1行、チームごとに列グループ(不参加の回は空欄)
const TEAM_COLS = [
  { id: 'shiryukai_univ', label: '立教大学紫龍会', foot: '第31回以前は「立教大紫龍会」表記' },
  { id: 'shiryukai', label: '紫龍会', foot: null },
] as const;
const historyRows = seasons.map(s => ({
  season: s,
  cells: TEAM_COLS.map(c => s.teams.find(t => t.team_id === c.id) ?? null) as (ShadanTeam | null)[],
}));
---

<BaseLayout
  title="社団戦(東将連) — 立教大学将棋部"
  description="東京アマチュア将棋連盟 社会人団体リーグ戦(社団戦)における立教関係チーム「立教大学紫龍会」「紫龍会」の成績。第12回(平成13年度)からの歴代成績と最新回の詳細を掲載しています。"
>
  <main>
    <h2 class="page-title">社団戦(東将連 社会人団体リーグ戦)</h2>
    <p class="lead">
      東京アマチュア将棋連盟が主催する社会人団体リーグ戦(社団戦)における、立教関係チームの成績です。
    </p>

    {latest === null ? (
      <div class="empty-notice">
        <p>社団戦データはまだ登録されていません。</p>
      </div>
    ) : (
      <>
        <section aria-labelledby="kai-title">
          <h3 id="kai-title" class="section-title">第{latest.kai}回（{latest.season_label}）</h3>

          <div class="team-grid">
            {latest.teams.map(team => (
              <article class="team-card">
                <header class="team-head">
                  <span class="team-name">{team.team_name}</span>
                  <span class="division-badge">{team.division}</span>
                </header>

                <dl class="stat">
                  <div><dt>順位</dt><dd class="rank">{team.rank != null ? `${team.rank}位` : '—'}</dd></div>
                  <div><dt>勝点</dt><dd>{team.points ?? '—'}</dd></div>
                  <div><dt>勝数</dt><dd>{team.wins ?? '—'}</dd></div>
                  <div>
                    <dt>昇降</dt>
                    <dd>
                      {team.promotion === '昇級' && <span class="promo up">▲昇級</span>}
                      {team.promotion === '降級' && <span class="promo down">▼降級</span>}
                      {team.promotion == null && <span class="promo none">残留</span>}
                    </dd>
                  </div>
                </dl>

                {team.league_table && (
                  <div class="league-table-wrap">
                    <table class="league-table">
                      <thead>
                        <tr><th>順位</th><th>チーム</th><th>勝点</th><th>勝数</th></tr>
                      </thead>
                      <tbody>
                        {team.league_table.rows.map(r => (
                          <tr class={r.team === team.team_name ? 'self' : ''}>
                            <td>{r.rank ?? '—'}</td><td>{r.team}</td>
                            <td>{r.points ?? '—'}</td><td>{r.wins ?? '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                <p class="source-link">
                  出典: <a href={team.source_url} target="_blank" rel="noopener">順位一覧表（PDF）</a>
                </p>
              </article>
            ))}
          </div>

          {latest.source && (
            <p class="sources">
              出典:
              {latest.source.hub_url && (
                <a href={latest.source.hub_url} target="_blank" rel="noopener">大会ページ</a>
              )}
              {latest.source.ichiran_pdf && (
                <a href={latest.source.ichiran_pdf} target="_blank" rel="noopener">順位一覧表（PDF）</a>
              )}
              {(latest.source.league_pdf ?? []).map((u, i) => (
                <a href={u} target="_blank" rel="noopener">リーグ表{i === 0 ? '（通常版）' : '（成績順）'}（PDF）</a>
              ))}
              <span class="src-note">（東京アマチュア将棋連盟）</span>
            </p>
          )}
        </section>

        <section aria-labelledby="history-title">
          <h3 id="history-title" class="section-title">歴代成績（第12回〜）</h3>
          <div class="history-wrap">
            <table class="history-table">
              <thead>
                <tr>
                  <th class="col-kai" rowspan="2">回（年度）</th>
                  {TEAM_COLS.map(c => <th class="team-col" colspan="3">{c.label}</th>)}
                </tr>
                <tr>
                  {TEAM_COLS.map(() => (
                    <>
                      <th class="sub">部・順位</th>
                      <th class="sub">勝点 / 勝数</th>
                      <th class="sub">昇降</th>
                    </>
                  ))}
                </tr>
              </thead>
              <tbody>
                {historyRows.map(({ season, cells }) => (
                  <tr>
                    <td class="col-kai">
                      第{season.kai}回 <span class="year">（{season.season_label}）</span>
                    </td>
                    {cells.map(team => team ? (
                      <>
                        <td class="c-div" title={team.note || undefined}>
                          <span class="division">{team.division}</span>
                          <span class={team.rank === 1 ? 'rank-1' : 'rank'}>
                            {team.rank != null ? (team.rank === 1 ? '優勝' : `${team.rank}位`) : '順位不明'}
                          </span>
                          <a class="src" href={team.source_url} target="_blank" rel="noopener">出典</a>
                        </td>
                        <td class="c-num">{team.points != null || team.wins != null ? `${team.points ?? '—'} / ${team.wins ?? '—'}` : '—'}</td>
                        <td class="c-promo">
                          {team.promotion === '昇級' && <span class="promo up">▲昇級</span>}
                          {team.promotion === '降級' && <span class="promo down">▼降級</span>}
                        </td>
                      </>
                    ) : (
                      <td class="c-absent" colspan="3">—</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-foot">
            ※ 立教大学紫龍会は第31回以前「立教大紫龍会」表記。空欄（—）は不参加・休会の回。
            第14回（平成15年度）はリーグ表が連盟サイトに現存しないため記録なし。
            「順位不明」はリーグ表が現存せず所属のみ確認できた回。各行の出典リンクから原本を確認できます。
          </p>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem; }
  .page-title { font-size: 1.3rem; color: #541a86; margin: 0 0 0.5rem; }
  .lead { font-size: 0.85rem; color: #777; margin: 0 0 1.5rem; }
  .section-title { font-size: 1.1rem; color: #541a86; border-bottom: 2px solid #541a86; padding-bottom: 0.3rem; margin-top: 2.2rem; }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
  .team-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 1rem 1.2rem; }
  .team-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.7rem; }
  .team-name { font-weight: bold; font-size: 1.05rem; color: #333; }
  .division-badge { font-size: 0.75rem; background: #efe9f7; color: #4a2a72; padding: 0.15rem 0.5rem; border-radius: 3px; font-weight: bold; }
  .stat { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin: 0; }
  .stat div { text-align: center; background: #f7f7f5; border-radius: 4px; padding: 0.4rem 0.2rem; }
  .stat dt { font-size: 0.7rem; color: #999; margin: 0; }
  .stat dd { margin: 0.15rem 0 0; font-size: 0.95rem; font-weight: bold; color: #333; }
  .stat dd.rank { color: #541a86; font-size: 1.05rem; }
  .promo { font-size: 0.85rem; padding: 0.1rem 0.35rem; border-radius: 3px; }
  .promo.up { background: #e0ffe0; color: #066; }
  .promo.down { background: #ffe0e0; color: #600; }
  .promo.none { color: #999; font-weight: normal; }
  .league-table-wrap { overflow-x: auto; margin-top: 0.8rem; }
  .league-table { border-collapse: collapse; width: 100%; font-size: 0.8rem; }
  .league-table th, .league-table td { border: 1px solid #ddd; padding: 0.2rem 0.4rem; text-align: center; }
  .league-table tr.self { background: #f4edfc; font-weight: bold; }
  .source-link { margin-top: 0.7rem; font-size: 0.75rem; }
  .source-link a { color: #888; }
  .source-link a:hover { color: #541a86; }
  .sources { font-size: 0.78rem; color: #888; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; align-items: center; }
  .sources a { color: #541a86; }
  .src-note { color: #aaa; }
  .empty-notice { text-align: center; padding: 3rem 1rem; color: #888; }

  .history-wrap { overflow-x: auto; background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; margin-top: 1rem; }
  .history-table { border-collapse: collapse; width: 100%; font-size: 0.82rem; min-width: 720px; }
  .history-table th { background: #f5f1fa; color: #541a86; font-size: 0.75rem; padding: 0.4rem 0.5rem; border-bottom: 1px solid #e4dcf0; white-space: nowrap; }
  .history-table th.team-col { font-size: 0.85rem; border-left: 2px solid #e4dcf0; text-align: center; }
  .history-table th.sub { font-weight: normal; color: #8a7a9e; border-bottom: 2px solid #e4dcf0; }
  .history-table th.col-kai { text-align: left; border-bottom: 2px solid #e4dcf0; }
  .history-table td { padding: 0.45rem 0.5rem; border-bottom: 1px solid #f1ecf7; white-space: nowrap; vertical-align: middle; }
  .history-table td.col-kai { font-weight: bold; color: #444; }
  .history-table td.col-kai .year { font-weight: normal; color: #999; font-size: 0.75rem; }
  .history-table td.c-div { border-left: 2px solid #f1ecf7; }
  .history-table .division { display: inline-block; background: #efe9f7; color: #4a2a72; font-weight: bold; font-size: 0.75rem; border-radius: 3px; padding: 0.1rem 0.4rem; margin-right: 0.4rem; }
  .history-table .rank { font-weight: bold; color: #333; }
  .history-table .rank-1 { font-weight: bold; color: #b8860b; }
  .history-table .src { margin-left: 0.5rem; font-size: 0.7rem; color: #aaa; }
  .history-table .src:hover { color: #541a86; }
  .history-table .c-num { color: #666; font-size: 0.78rem; }
  .history-table .c-promo .promo { font-size: 0.72rem; }
  .history-table .c-absent { color: #ccc; text-align: center; border-left: 2px solid #f1ecf7; }
  .history-table tbody tr:hover { background: #fbf9fd; }
  .table-foot { font-size: 0.72rem; color: #999; margin-top: 0.6rem; line-height: 1.7; }
</style>
