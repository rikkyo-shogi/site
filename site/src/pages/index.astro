---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: '立教大学将棋部',
  url: 'https://rikkyo-shogi.github.io/site/',
  sport: '将棋',
  memberOf: { '@type': 'CollegeOrUniversity', name: '立教大学' },
});
---

<BaseLayout
  title="立教大学将棋部"
  description="立教大学将棋部の公式アーカイブサイト。関東大学将棋連盟の学生大会成績（平成21年度以降）と、東京アマチュア将棋連盟 社団戦の成績を公開しています。"
>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <main>
    <div class="hero">
      <h2>立教大学将棋部</h2>
      <p>学生大会・社団戦の成績を公開しています。</p>
    </div>

    <div class="menu">
      <a class="menu-card" href={`${base}/result/`}>
        <h3>学生大会結果</h3>
        <p>関東大学将棋連盟の公式成績をシーズン別に掲載。平成21年度以降の全記録。</p>
      </a>
      <a class="menu-card" href={`${base}/shadan/`}>
        <h3>社団戦結果</h3>
        <p>東京アマチュア将棋連盟 社会人団体リーグ戦の成績。今年度の途中経過と歴代の記録。</p>
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  main { max-width: 700px; margin: 0 auto; padding: 3rem 1rem; }
  .hero { text-align: center; margin-bottom: 3rem; }
  .hero h2 { font-size: 1.8rem; color: #541a86; margin: 0 0 0.5rem; }
  .hero p { color: #666; font-size: 0.95rem; margin: 0; }
  .menu { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .menu-card {
    background: #fff; border: 1px solid #e0e0e0; border-radius: 8px;
    padding: 1.5rem 1.2rem; text-decoration: none; color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .menu-card:hover { box-shadow: 0 3px 10px rgba(0,0,0,0.1); border-color: #541a86; }
  .menu-card h3 { margin: 0 0 0.5rem; font-size: 1.1rem; color: #541a86; }
  .menu-card p { margin: 0; font-size: 0.85rem; color: #666; }
  @media (max-width: 500px) {
    .menu { grid-template-columns: 1fr; }
    .hero h2 { font-size: 1.4rem; }
  }
</style>
