---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadAllSeasons } from '../../utils/loadData';
import SeasonSection from '../../components/SeasonSection.astro';
import LeagueTrend from '../../components/LeagueTrend.astro';

const seasons = await loadAllSeasons();
---

<BaseLayout
  title="大会結果 — 立教大学将棋部"
  description="立教大学将棋部の大会成績一覧。関東大学将棋連盟の団体戦・個人戦の公式結果をシーズン別（平成21年度〜令和8年度）に掲載しています。"
>
  <main>
    <h2 style="font-size:1.1rem;color:#555;margin-bottom:0.5rem;">大会成績一覧</h2>
    <p style="font-size:0.85rem;color:#888;margin:0 0 1rem;">
      関東大学将棋連盟の公式成績をシーズン別にまとめています。出典リンクから原本をご確認いただけます。
    </p>

    {seasons.length > 0 && <LeagueTrend seasons={seasons} />}

    {seasons.length === 0 ? (
      <div class="empty-notice">
        <p>データはまだ登録されていません。</p>
        <p style="font-size:0.8rem;">スクレイパーで成績を取得し、<code>data/confirmed/</code> に配置するとここに表示されます。</p>
      </div>
    ) : (
      <>
        <nav class="season-nav" aria-label="年度ナビゲーション">
          {seasons.map(s => <a href={`#${s.season}`}>{s.season_label}</a>)}
        </nav>
        {seasons.map(s => <SeasonSection season={s} />)}
      </>
    )}
  </main>
</BaseLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem; }
  .season-nav { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem; }
  .season-nav a {
    background: #fff; border: 1px solid #ccc; border-radius: 4px;
    padding: 0.25rem 0.6rem; font-size: 0.8rem; color: #555; text-decoration: none;
  }
  .season-nav a:hover { background: #541a86; color: #fff; border-color: #541a86; }
  .season-section { border-top: 2px solid #541a86; margin-top: 2.5rem; padding-top: 1rem; }
  .season-title { margin: 0 0 1rem; font-size: 1.3rem; color: #541a86; }
  .season-title a { color: inherit; text-decoration: none; }
  .season-title a:hover { text-decoration: underline; }
  .event-group { margin-bottom: 1.5rem; }
  .event-group h3 { font-size: 1rem; color: #666; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem; margin-bottom: 0.75rem; }
  .national-group h3 { color: #003087; }
  .event-card {
    background: #fff; border: 1px solid #e0e0e0; border-radius: 6px;
    padding: 0.75rem 1rem; margin-bottom: 0.6rem; transition: box-shadow 0.15s;
  }
  .event-card:hover { box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
  .event-card.highlight { border-left: 4px solid #d4a000; }
  .event-header { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.3rem; }
  .event-name { font-weight: bold; font-size: 0.95rem; }
  .badge { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 3px; font-weight: bold; }
  .badge.division { background: #eef; color: #446; }
  .badge.national { background: #003087; color: #fff; }
  .badge.unofficial { background: #888; color: #fff; }
  .event-meta { font-size: 0.78rem; color: #888; margin-bottom: 0.4rem; }
  .result-row { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.88rem; }
  .rank { font-size: 1rem; font-weight: bold; color: #541a86; }
  .promo { font-weight: bold; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.8rem; }
  .promo.up { background: #e0ffe0; color: #066; }
  .promo.down { background: #ffe0e0; color: #600; }
  .player-list { list-style: none; padding: 0; margin: 0.3rem 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .player-list li { background: #f5f5f5; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; display: flex; gap: 0.3rem; align-items: center; }
  .player-list li.highlight { background: #fff8e0; border: 1px solid #d4a000; }
  .player-name { font-weight: bold; }
  .grade { color: #888; font-size: 0.78rem; }
  .best-result { color: #541a86; font-size: 0.82rem; }
  .source-link { margin-top: 0.4rem; font-size: 0.75rem; }
  .source-link a { color: #888; }
  .source-link a:hover { color: #541a86; }
  .no-data { color: #aaa; font-style: italic; font-size: 0.85rem; }
  .empty-notice { text-align: center; padding: 3rem 1rem; color: #888; }
  @media (max-width: 600px) {
    .result-row { font-size: 0.82rem; }
    .event-card { padding: 0.6rem 0.75rem; }
  }
</style>

{/* ヘッダーはBaseLayout側にあるため、このページ固有のモバイル調整はglobalで当てる */}
<style is:global>
  @media (max-width: 600px) {
    header h1 { font-size: 1.1rem; }
  }
</style>
