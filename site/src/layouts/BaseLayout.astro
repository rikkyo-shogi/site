---
interface Props {
  title: string;
  description: string;
  /** OGP画像のパス(base込み)。省略時はデフォルト画像 */
  image?: string;
  /** og:type。省略時 'website' */
  ogType?: string;
  /** フッターの表記。省略時は出典付きの標準表記 */
  footerText?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description,
  image = `${base}/ogp.png`,
  ogType = 'website',
  footerText = '立教大学将棋部 ／ 出典: 関東大学将棋連盟・全日本学生将棋連盟・東京アマチュア将棋連盟・部内掲示板',
} = Astro.props;

// Astro.site は astro.config.mjs の site (https://rikkyo-shogi.github.io/site)
// Astro.url.pathname は base(/site) を含むため、origin と組み合わせて絶対URLを生成する
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- OGP -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:site_name" content="立教大学将棋部" />
  <meta property="og:locale" content="ja_JP" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <!-- Google Search Console 所有権確認用。
       Search Console にプロパティ登録後、発行されたトークンで content を差し替えること。 -->
  <meta name="google-site-verification" content="qN0VQQih3Z4914kmqTSb8TKGqnw3QYmaQX6eDsmvnBo" />

  <slot name="head" />
</head>
<body>
  <header>
    <h1><a href={`${base}/`}>立教大学将棋部</a></h1>
    <nav>
      <a href={`${base}/result/`}>学生大会結果</a>
      <a href={`${base}/shadan/`}>社団戦結果</a>
      <a href={`${base}/archives/`}>掲示板アーカイブ</a>
    </nav>
  </header>

  <slot />

  <footer>
    <nav class="sns-links" aria-label="公式SNS">
      <a href="https://x.com/rikkyoshogi" target="_blank" rel="noopener" aria-label="X (Twitter)" title="X (Twitter)">
        <!-- X 公式ロゴ -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a href="https://www.instagram.com/rikkyoshogi" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
        <!-- Instagram 公式グリフ -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
        </svg>
      </a>
      <a href="https://note.com/rikkyoshogi" target="_blank" rel="noopener" aria-label="note" title="note" class="note-link">
        <!-- note ワードマーク -->
        <svg viewBox="0 0 48 20" width="44" height="20" aria-hidden="true">
          <text x="0" y="15" font-family="'Helvetica Neue', Arial, sans-serif" font-size="15" font-weight="700" fill="currentColor">note</text>
        </svg>
      </a>
    </nav>
    <p class="footer-text">{footerText}</p>
  </footer>
</body>
</html>

<style>
  body {
    font-family: 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
    background: #fafaf8; color: #333; margin: 0; padding: 0;
  }
  header {
    /* 立教スクールカラーの紫紺(DIC 226相当) */
    background: #541a86; color: #fff;
    padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1rem;
  }
  header h1 { margin: 0; font-size: 1.4rem; }
  header h1 a { color: inherit; text-decoration: none; }
  header nav a { color: #d8c8ee; text-decoration: none; margin-left: 1rem; font-size: 0.9rem; }
  header nav a:hover { text-decoration: underline; }
  footer { text-align: center; font-size: 0.75rem; color: #aaa; padding: 2rem 1rem; border-top: 1px solid #eee; margin-top: 3rem; }
  .sns-links { display: flex; justify-content: center; align-items: center; gap: 0.9rem; margin-bottom: 0.9rem; }
  .sns-links a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    color: #541a86; background: #fff; border: 1px solid #ddd2ec;
    text-decoration: none; transition: background 0.15s, color 0.15s;
  }
  .sns-links a.note-link { width: auto; padding: 0 0.8rem; border-radius: 999px; }
  .sns-links a:hover { background: #541a86; color: #fff; border-color: #541a86; }
  .footer-text { margin: 0; }
</style>
